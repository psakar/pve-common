#!/bin/sh
### BEGIN INIT INFO
# Provides:          pve-service-instances
# Required-Start:    $remote_fs $network $syslog
# Required-Stop:     $remote_fs $network $syslog
# Should-Start:      dbus
# Should-Stop:       dbus
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Proxmox VE template service instances
### END INIT INFO

# Only installed by the pkg.pve-common.lsbservice build (see debian/rules).
# Starts the instances of template services (name@instance) enabled via
# PVE::InitSystem's LSBService backend at boot, e.g. the SDN's per-zone dnsmasq
# instances, and stops the started ones at shutdown. Runlevel links can't
# represent such instances; they are run by their template's init script with
# the instance as additional argument, directly rather than via service(8),
# which would record the template script itself as started or stopped for
# OpenRC.

. /lib/lsb/init-functions

ENABLED_DIR=/var/lib/pve-initsystem/enabled-instances
STARTED_DIR=/run/pve-initsystem/started-instances

case "$1" in
    start)
        mkdir -p $STARTED_DIR
        for marker in $ENABLED_DIR/*@*; do
            [ -e "$marker" ] || continue
            name=${marker##*/}
            template=${name%%@*}
            instance=${name#*@}
            log_daemon_msg "Starting template service instance" "$name"
            if /etc/init.d/"$template" start "$instance" >/dev/null; then
                : > "$STARTED_DIR/$name"
                log_end_msg 0
            else
                log_end_msg 1
            fi
        done
        ;;
    stop)
        for marker in $STARTED_DIR/*@*; do
            [ -e "$marker" ] || continue
            name=${marker##*/}
            template=${name%%@*}
            instance=${name#*@}
            log_daemon_msg "Stopping template service instance" "$name"
            /etc/init.d/"$template" stop "$instance" >/dev/null
            log_end_msg $?
            rm -f "$marker"
        done
        ;;
    restart|force-reload)
        "$0" stop
        "$0" start
        ;;
    status)
        ls $STARTED_DIR 2>/dev/null
        exit 0
        ;;
    *)
        echo "Usage: /etc/init.d/pve-service-instances {start|stop|restart|force-reload|status}" >&2
        exit 3
        ;;
esac
