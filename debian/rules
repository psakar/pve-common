#!/usr/bin/make -f
# -*- makefile -*-
# Sample debian/rules that uses debhelper.
# This file was originally written by Joey Hess and Craig Small.
# As a special exception, when this file is copied by dh-make into a
# dh-make output file, you may use that output file without restriction.
# This special exception was added by Craig Small in version 0.37 of dh-make.

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

# Select the PVE::InitSystem backend to build against (see src/Makefile's
# PVE_INIT_SYSTEM variable) based on whether the pkg.pve-common.lsbservice
# build profile is active. This is primarily for Devuan and other
# systemd-free Debian derivatives; to build this variant, run:
#   dpkg-buildpackage -b -us -uc -Ppkg.pve-common.lsbservice
ifneq (,$(filter pkg.pve-common.lsbservice,$(DEB_BUILD_PROFILES)))
export PVE_INIT_SYSTEM = lsbservice
else
export PVE_INIT_SYSTEM = systemd
endif

%:
	dh $@
